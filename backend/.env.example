# --- Obbligatorie ---------------------------------------------------------
# Unico amministratore creato all'avvio (sempre admin, non modificabile da UI)
ADMIN_EMAIL=tu@example.com
# Cartella delle foto: le foto del libro 57 finiscono in $BOOKS_DIR/57
BOOKS_DIR=/home/pippo/libri
# Chiave per firmare sessioni e link alle foto (es: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=cambiami

# --- Claude Code -------------------------------------------------------------
CLAUDE_CODE_OAUTH_TOKEN=
# Percorso del comando claude, se non è nel PATH del backend
CLAUDE_BIN=claude

# --- Vinted (pacchetto vinted-lister, installato con pip install -e) -------------
# File dei token di sessione: lo stesso indicato a `vinted auth import` tramite
# la variabile d'ambiente VINTED_ENV_FILE. Deve contenere anche VINTED_DOMAIN=it.
# L'utente di uvicorn deve poter scrivere nel file e nella sua cartella (refresh).
VINTED_ENV_FILE=

# --- Indirizzi -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/libri.db
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Login ------------------------------------------------------------------------
# Google: redirect URI = $BACKEND_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID): redirect URI = $BACKEND_URL/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
